{
  "$defs": {
    "Attempt": {
      "description": "One attempt, recorded whether or not it produced anything.",
      "properties": {
        "degraded": {
          "description": "Fields this attempt could not honour.",
          "items": {
            "$ref": "#/$defs/Degraded"
          },
          "type": "array"
        },
        "duration_millis": {
          "description": "How long it took.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "index": {
          "description": "Position in the ledger.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "description": "The target. Empty for a preflight refusal, which never had one.",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/AttemptOutcome",
          "description": "How it ended."
        },
        "phase": {
          "$ref": "#/$defs/AttemptPhase",
          "description": "Where it happened."
        },
        "trigger": {
          "$ref": "#/$defs/AttemptTrigger",
          "description": "What caused it."
        },
        "usage": {
          "$ref": "#/$defs/Usage",
          "description": "What it consumed, if anything."
        }
      },
      "required": [
        "index",
        "model",
        "phase",
        "trigger",
        "outcome",
        "usage",
        "duration_millis",
        "degraded"
      ],
      "type": "object"
    },
    "AttemptOutcome": {
      "description": "How an attempt ended.",
      "oneOf": [
        {
          "description": "It answered.",
          "properties": {
            "outcome": {
              "const": "ok",
              "type": "string"
            }
          },
          "required": [
            "outcome"
          ],
          "type": "object"
        },
        {
          "description": "It did not. Present even when a partial answer was streamed, because that one still\ncost money.",
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode",
              "description": "A stable category."
            },
            "outcome": {
              "const": "failed",
              "type": "string"
            },
            "reason": {
              "description": "For humans.",
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "code",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "AttemptPhase": {
      "description": "Where in a call an attempt happened.",
      "oneOf": [
        {
          "const": "preflight",
          "description": "Compiling and checking, before anything was sent.",
          "type": "string"
        },
        {
          "const": "execute",
          "description": "The provider call itself.",
          "type": "string"
        },
        {
          "const": "circuit_open",
          "description": "Refused before it happened.",
          "type": "string"
        }
      ]
    },
    "AttemptTrigger": {
      "description": "What caused an attempt.",
      "oneOf": [
        {
          "const": "selection",
          "description": "The first attempt for the chosen target.",
          "type": "string"
        },
        {
          "const": "retry",
          "description": "Another try at the same target.",
          "type": "string"
        },
        {
          "const": "fallback",
          "description": "A hop to the next target.",
          "type": "string"
        }
      ]
    },
    "Budget": {
      "description": "What a session may consume.",
      "properties": {
        "max_micros_usd": {
          "description": "Cost in micro-USD.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_steps": {
          "description": "Turns a session may take.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tokens": {
          "description": "Tokens across every model call.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_wall_millis": {
          "description": "Wall clock in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Content": {
      "description": "An ordered multimodal payload.",
      "properties": {
        "parts": {
          "description": "The parts, in order.",
          "items": {
            "$ref": "#/$defs/Part"
          },
          "type": "array"
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "DataPart": {
      "description": "Structured output. JSON text rather than bytes, because JSON is UTF-8 by definition and\ntext is what every toolchain can read.",
      "properties": {
        "json": {
          "description": "The JSON, as text.",
          "type": "string"
        },
        "media_type": {
          "description": "The media type, usually `application/json`.",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "json"
      ],
      "type": "object"
    },
    "Degraded": {
      "description": "A field the provider could not honour.\n\nRecorded rather than swallowed: a `tool_choice = Required` that quietly became `Auto` is a\nsession behaving differently than it was configured to, and the difference is\nundiscoverable afterwards.",
      "properties": {
        "field": {
          "description": "The request field, e.g. `tool_choice`.",
          "type": "string"
        },
        "reason": {
          "description": "Why, in the provider's terms.",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "type": "object"
    },
    "ErrorBody": {
      "description": "The body of a failed request.\n\nOne shape for every failure: a caller should not have to know which endpoint it called to\nknow how to read why it failed.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode",
          "description": "A stable category programs match on."
        },
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Machine-readable detail, e.g. `{\"needed_tokens\": \"40000\"}`.",
          "type": "object"
        },
        "reason": {
          "description": "For humans. Never parsed.",
          "type": "string"
        },
        "retry_after_millis": {
          "description": "When to retry, in milliseconds. Absent means no hint.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "retryable": {
          "description": "A statement about this request, not about the world.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "reason",
        "retryable"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "A stable error category.\n\nCodes are enums rather than strings because the first caller who compares a string\nfreezes it forever.",
      "oneOf": [
        {
          "const": "invalid",
          "description": "The request was malformed.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "The thing named does not exist.",
          "type": "string"
        },
        {
          "const": "denied",
          "description": "Policy refused.",
          "type": "string"
        },
        {
          "const": "budget",
          "description": "A budget was exhausted.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "A deadline passed.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "A dependency was not reachable.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "A bug.",
          "type": "string"
        }
      ]
    },
    "Event": {
      "description": "An append-only record of something that happened.\n\n`seq` is dense and gap-free, which is what makes it usable as a resume cursor without\na separate acknowledgement protocol. `schema_version` is written alongside the event so\na reader can upcast instead of guessing.",
      "properties": {
        "at_unix_millis": {
          "description": "Unix milliseconds, from the injected clock so replay is deterministic.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/EventKind",
          "description": "What happened."
        },
        "meta": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Opaque extension, same rule as [`Part::meta`].",
          "type": "object"
        },
        "schema_version": {
          "description": "The schema this event was written with.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "seq": {
          "description": "Monotonic within a session, starting at 0.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/SessionId",
          "description": "The session this belongs to."
        }
      },
      "required": [
        "seq",
        "session",
        "at_unix_millis",
        "schema_version",
        "kind"
      ],
      "type": "object"
    },
    "EventKind": {
      "description": "The payload of an [`Event`].\n\nEvents carry the content model rather than copies of its fields — [`ToolCall`] here is\nthe same type a [`ToolCallPart`] holds — so a live stream and a stored history cannot\ndisagree about the shape of an answer.",
      "oneOf": [
        {
          "description": "A session state transition, with the reason when it is terminal.",
          "properties": {
            "kind": {
              "const": "state_changed",
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/SessionState",
              "description": "The state entered."
            },
            "stop": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StopReason"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Set when the state is terminal."
            }
          },
          "required": [
            "kind",
            "state"
          ],
          "type": "object"
        },
        {
          "description": "A fragment of assistant text.",
          "properties": {
            "kind": {
              "const": "text_delta",
              "type": "string"
            },
            "part_index": {
              "description": "Which part of the message it belongs to.\n\nWithout it a client cannot tell a second text block from a continuation of the\nfirst, so text → tool call → more text is unrepresentable in the stream.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "The fragment.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "part_index",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "A fragment of a reasoning trace.\n\n`signature` usually arrives on its own, in a delta with empty `text`: a provider\nsigns the finished block rather than each fragment.",
          "properties": {
            "kind": {
              "const": "reasoning_delta",
              "type": "string"
            },
            "part_index": {
              "description": "Which part of the message it belongs to.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "signature": {
              "description": "The provider's signature fragment, returned verbatim.",
              "type": "string"
            },
            "text": {
              "description": "The fragment.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "part_index",
            "text",
            "signature"
          ],
          "type": "object"
        },
        {
          "description": "A tool call began. Its arguments follow as [`EventKind::ToolCallArgs`].",
          "properties": {
            "deadline_unix_millis": {
              "description": "Wall-clock deadline for this call.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "index": {
              "description": "Position in this turn's tool-call list.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "tool_call_started",
              "type": "string"
            },
            "name": {
              "description": "The tool name.",
              "type": "string"
            },
            "progress_token": {
              "description": "When set, the tool reports progress under this token.",
              "type": "string"
            },
            "tool_call_id": {
              "description": "The correlation id the result will be filed under.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "index",
            "tool_call_id",
            "name",
            "deadline_unix_millis",
            "progress_token"
          ],
          "type": "object"
        },
        {
          "description": "A fragment of one call's arguments.\n\nArguments stream as text because that is what providers send and because a partial\nobject cannot be handed to a tool. The kernel assembles and validates before anything\nruns; malformed arguments become a result the model can read.",
          "properties": {
            "fragment": {
              "description": "The fragment.",
              "type": "string"
            },
            "index": {
              "description": "Which call this fragment belongs to.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "tool_call_args",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "index",
            "fragment"
          ],
          "type": "object"
        },
        {
          "description": "A tool call resolved.",
          "properties": {
            "duration_millis": {
              "description": "How long it took.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "tool_finished",
              "type": "string"
            },
            "result": {
              "$ref": "#/$defs/ToolResult",
              "description": "The result — the same value that enters history."
            }
          },
          "required": [
            "kind",
            "duration_millis",
            "result"
          ],
          "type": "object"
        },
        {
          "description": "One model call's consumption, debited whether or not the answer was usable.",
          "properties": {
            "attempt_index": {
              "description": "Which attempt in the ledger it belongs to.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "usage",
              "type": "string"
            },
            "model": {
              "description": "The model that served it, after routing.",
              "type": "string"
            },
            "purpose": {
              "$ref": "#/$defs/Purpose",
              "description": "Why the call happened, so a summary's spend can be told from an answer's."
            },
            "usage": {
              "$ref": "#/$defs/Usage",
              "description": "What it consumed."
            }
          },
          "required": [
            "kind",
            "usage",
            "purpose",
            "model",
            "attempt_index"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Degraded",
          "description": "A field the provider could not honour.\n\nReported, never swallowed: a `tool_choice = Required` that quietly became `Auto` is a\nsession behaving differently than it was configured to.",
          "properties": {
            "kind": {
              "const": "capability_degraded",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "One attempt ended badly. Recorded because a retry does not erase the attempt that failed,\nor the money it spent.",
          "properties": {
            "attempt": {
              "$ref": "#/$defs/Attempt",
              "description": "What happened."
            },
            "kind": {
              "const": "attempt_failed",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "attempt"
          ],
          "type": "object"
        },
        {
          "description": "A policy verdict of `AskHuman` was reached.",
          "properties": {
            "default_if_unanswered": {
              "$ref": "#/$defs/PermissionKind",
              "description": "What the kernel does if nobody answers. A refusal, not a silent approval."
            },
            "kind": {
              "const": "awaiting_human",
              "type": "string"
            },
            "options": {
              "description": "Typed answers, so a client can render \"once\" and \"always\" differently and the\nverdict can say which was chosen.",
              "items": {
                "$ref": "#/$defs/PermissionOption"
              },
              "type": "array"
            },
            "question": {
              "description": "What the host should ask.",
              "type": "string"
            },
            "tool_call_id": {
              "description": "The call being gated.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "question",
            "tool_call_id",
            "options",
            "default_if_unanswered"
          ],
          "type": "object"
        },
        {
          "description": "A budget dimension ran out.",
          "properties": {
            "kind": {
              "const": "budget_exhausted",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/StopReason",
              "description": "Which one."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "Something failed.",
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode",
              "description": "A stable code for programs."
            },
            "kind": {
              "const": "failed",
              "type": "string"
            },
            "reason": {
              "description": "For humans.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The session moved to a newer tool-source generation.\n\nRecorded rather than inferred, so a replay reproduces which tool set each turn ran\nagainst.",
          "properties": {
            "from": {
              "$ref": "#/$defs/Generation",
              "description": "Where it came from."
            },
            "kind": {
              "const": "generation_migrated",
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/Generation",
              "description": "Where it went."
            }
          },
          "required": [
            "kind",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "description": "The assembled message a model call produced.\n\nDeltas are a rendering protocol; this is the record. Some content can only be\nassembled — a reasoning signature arrives as its own delta — and a client that joins\nlate should render without replaying every fragment.",
          "properties": {
            "kind": {
              "const": "message_completed",
              "type": "string"
            },
            "message": {
              "$ref": "#/$defs/Message",
              "description": "The message, as it enters history."
            },
            "step_index": {
              "description": "Which step of the turn produced it.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "message",
            "step_index"
          ],
          "type": "object"
        },
        {
          "description": "Progress from a long-running call. A call whose only feedback is a deadline is\nindistinguishable from a hang.",
          "properties": {
            "done": {
              "description": "Units completed.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "progress",
              "type": "string"
            },
            "message": {
              "description": "For humans.",
              "type": "string"
            },
            "token": {
              "description": "The token from [`EventKind::ToolCallStarted`].",
              "type": "string"
            },
            "total": {
              "description": "Units expected. Zero means unknown, not zero.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "token",
            "done",
            "total",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "FilePart": {
      "description": "A reference to content that is not carried here: an artifact, a workspace file, or a\ntruncated tool result's spill.\n\nThis is also how truncation is expressed. A result too large to store is spilled; the\ntext keeps a marker and this part keeps the pointer. That is a policy outcome, not an\nerror.",
      "properties": {
        "media_type": {
          "description": "What it is.",
          "type": "string"
        },
        "name": {
          "description": "A human-facing name.",
          "type": "string"
        },
        "uri": {
          "description": "Where to find it.",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "media_type",
        "name"
      ],
      "type": "object"
    },
    "Format": {
      "description": "The shape the answer must have.",
      "oneOf": [
        {
          "description": "Prose.",
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A JSON object, schema unchecked.",
          "properties": {
            "kind": {
              "const": "json_object",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A JSON object that must match the schema.",
          "properties": {
            "kind": {
              "const": "json_schema",
              "type": "string"
            },
            "name": {
              "description": "The name the provider files it under.",
              "type": "string"
            },
            "schema": {
              "description": "The schema, as a JSON object."
            }
          },
          "required": [
            "kind",
            "name",
            "schema"
          ],
          "type": "object"
        }
      ]
    },
    "Generation": {
      "description": "A tool-source generation.\n\nGenerations are immutable snapshots of the declared sources. A session is pinned to\none at start and may only move forward at a turn boundary, and only when the two\ngenerations are compatible.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "ImagePart": {
      "description": "An image.",
      "properties": {
        "source": {
          "$ref": "#/$defs/MediaSource",
          "description": "Where the bytes are."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Ledger": {
      "description": "Every attempt a call made, and the sum.",
      "properties": {
        "attempts": {
          "description": "In order.",
          "items": {
            "$ref": "#/$defs/Attempt"
          },
          "type": "array"
        },
        "total": {
          "$ref": "#/$defs/Usage",
          "description": "The sum across every attempt that produced tokens."
        }
      },
      "required": [
        "attempts",
        "total"
      ],
      "type": "object"
    },
    "MediaFrom": {
      "description": "Where media bytes live.",
      "oneOf": [
        {
          "description": "A URL to fetch.",
          "properties": {
            "from": {
              "const": "url",
              "type": "string"
            },
            "url": {
              "description": "The URL.",
              "type": "string"
            }
          },
          "required": [
            "from",
            "url"
          ],
          "type": "object"
        },
        {
          "description": "Bytes carried inline.",
          "properties": {
            "data": {
              "description": "The bytes.",
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "from": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "from",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "MediaSource": {
      "description": "Bytes, or a reference to them, plus the type that makes them renderable.\n\n`url` exists because inlining a large image into an event log is a storage incident: the\nlog is append-only and replayed, so every byte is paid for on every replay. `data` exists\nbecause a caller with no reachable store must still be able to send one.",
      "properties": {
        "from": {
          "$ref": "#/$defs/MediaFrom",
          "description": "Where the bytes come from."
        },
        "media_type": {
          "description": "The media type, e.g. `image/png`. Required: bytes without a type are not renderable.",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "from"
      ],
      "type": "object"
    },
    "Message": {
      "description": "One turn's worth of content.",
      "properties": {
        "content": {
          "$ref": "#/$defs/Content",
          "description": "What it contains.\n\nNon-empty whenever the kernel writes one: an empty content is a bug in whatever\nproduced it, not something a reader has to tolerate."
        },
        "role": {
          "$ref": "#/$defs/Role",
          "description": "Who produced it."
        }
      },
      "required": [
        "role",
        "content"
      ],
      "type": "object"
    },
    "Params": {
      "description": "Generation parameters, as the wire carries them.\n\nMirrors `nucleos::adapter::GenerateParams`, but as a `#[serde(default)]`-friendly struct:\na caller should be able to send `{}` and get the defaults, which is not true of the kernel's\ntype because its `TextFormat` is an enum.",
      "properties": {
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/Format"
            },
            {
              "type": "null"
            }
          ],
          "description": "`text`, `json_object`, or a JSON Schema object to conform to."
        },
        "max_output_tokens": {
          "description": "The completion ceiling.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reasoning_effort": {
          "description": "Reasoning effort, for models that expose one.",
          "type": [
            "string",
            "null"
          ]
        },
        "stop": {
          "default": [],
          "description": "Sequences that end the completion.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "temperature": {
          "description": "Sampling temperature.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "tool_choice": {
          "description": "`auto`, `required` or `none`.",
          "type": [
            "string",
            "null"
          ]
        },
        "top_p": {
          "description": "Nucleus sampling.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Part": {
      "description": "One piece of content.\n\nThe union is small on purpose: seven kinds. Audio and video are [`PartKind::File`] with an\n`audio/*` or `video/*` media type, because the kernel moves those bytes and never\ninterprets them. A kind is added when the kernel must act differently — not when a\nprovider can emit something new.",
      "oneOf": [
        {
          "$ref": "#/$defs/TextPart",
          "description": "Plain text.",
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ImagePart",
          "description": "An image, inline or referenced.",
          "properties": {
            "kind": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/FilePart",
          "description": "A reference to content that is not carried here.",
          "properties": {
            "kind": {
              "const": "file",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/DataPart",
          "description": "Structured output.",
          "properties": {
            "kind": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ToolCallPart",
          "description": "The model asking for a tool.",
          "properties": {
            "kind": {
              "const": "tool_call",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ToolResultPart",
          "description": "A tool's answer, folded back into history.",
          "properties": {
            "kind": {
              "const": "tool_result",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ReasoningPart",
          "description": "A provider reasoning trace.",
          "properties": {
            "kind": {
              "const": "reasoning",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "meta": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Contextual or vendor-specific data.\n\nThe kernel never reads it, never interprets it, and never rejects an unknown key.\nThis is the only extension hatch: a schema with two of them has everyone using the\nother one.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "PermissionKind": {
      "description": "The kinds of answer a permission request offers.",
      "oneOf": [
        {
          "const": "allow_once",
          "description": "Allow this call.",
          "type": "string"
        },
        {
          "const": "allow_always",
          "description": "Allow this call and, if the host agrees, this tool for the session.",
          "type": "string"
        },
        {
          "const": "reject",
          "description": "Refuse this call.",
          "type": "string"
        }
      ]
    },
    "PermissionOption": {
      "description": "What a human may answer when a call is gated.\n\nThe kernel *reports* the choice; it never decides that \"always\" applies. That is policy,\nand it belongs to the host.",
      "properties": {
        "id": {
          "description": "Caller-chosen, returned verbatim in the verdict.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PermissionKind",
          "description": "What it means."
        },
        "label": {
          "description": "For humans.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "type": "object"
    },
    "Purpose": {
      "description": "Why a model call is happening.\n\nThe kernel makes calls of its own — a compaction summary is one — so the purpose has to be\nfirst-class: a budget whose summarisation spend is indistinguishable from answer spend is a\nbudget nobody can explain after the fact.",
      "oneOf": [
        {
          "const": "answer",
          "description": "The answer the caller is waiting for.",
          "type": "string"
        },
        {
          "const": "summary",
          "description": "The kernel's own bookkeeping.",
          "type": "string"
        },
        {
          "const": "repair",
          "description": "Another try at a turn that produced something unusable.",
          "type": "string"
        }
      ]
    },
    "ReasoningPart": {
      "description": "One provider reasoning trace.\n\n`signature` is why this is not a plain string: some providers sign a reasoning block and\nreject the next turn when the signature is not returned verbatim. Dropping it turns a\nmulti-turn session into a failure on turn two. `id` and `source` exist for the same\nreason — they are opaque to the kernel and must round-trip.",
      "properties": {
        "id": {
          "description": "The provider's item id, when it uses one.",
          "type": "string"
        },
        "signature": {
          "description": "The provider's signature, returned verbatim.",
          "type": "string"
        },
        "source": {
          "description": "The provider's verification scope.",
          "type": "string"
        },
        "text": {
          "description": "The reasoning text. May be empty when the provider withholds it.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "signature",
        "id",
        "source"
      ],
      "type": "object"
    },
    "Role": {
      "description": "Who produced a message.\n\nThe set is the smallest one every provider can express. A provider with a fifth role\nmaps it onto one of these in its adapter — the kernel does not learn it.",
      "oneOf": [
        {
          "const": "system",
          "description": "Instructions.",
          "type": "string"
        },
        {
          "const": "user",
          "description": "The caller.",
          "type": "string"
        },
        {
          "const": "assistant",
          "description": "The model.",
          "type": "string"
        },
        {
          "const": "tool",
          "description": "A tool's output.",
          "type": "string"
        }
      ]
    },
    "SessionId": {
      "description": "A session identifier.\n\nThe caller chooses it when resuming, so it is a string rather than an opaque handle.\nThat makes a retried `Start` idempotent instead of creating a second session.",
      "type": "string"
    },
    "SessionState": {
      "description": "Where a session is in its life.\n\nThe vocabulary is the session's, not a provider's. `AwaitingHuman` is a state rather\nthan a callback, so a confirmation that arrives three hours later resumes a session\ninstead of reviving a stack frame.",
      "oneOf": [
        {
          "const": "created",
          "description": "Allocated, spec not yet applied.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "Driving a turn.",
          "type": "string"
        },
        {
          "const": "awaiting_tool",
          "description": "A tool call is in flight.",
          "type": "string"
        },
        {
          "const": "awaiting_human",
          "description": "Blocked on a human decision.",
          "type": "string"
        },
        {
          "const": "cancelling",
          "description": "Stopping: finish the current turn, then checkpoint.",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Finished normally.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Finished with an error.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Stopped on request.",
          "type": "string"
        }
      ]
    },
    "StartRequest": {
      "description": "What a caller must send to create a session.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/Budget",
          "default": {},
          "description": "What the session may consume."
        },
        "credit_tokens": {
          "default": 0,
          "description": "Tokens granted up front, spent by usage. Zero means \"no credit, no model calls\".",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "initial": {
          "default": [],
          "description": "The opening messages.",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "model_chain": {
          "description": "The route, first name that answers wins. Absent asks for the daemon's default.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "params": {
          "$ref": "#/$defs/Params",
          "default": {
            "stop": []
          },
          "description": "How to shape answers."
        },
        "resume": {
          "default": false,
          "description": "Continue an existing session instead of creating one.",
          "type": "boolean"
        },
        "retries": {
          "default": 0,
          "description": "Extra attempts per target before falling through.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "system": {
          "description": "Standing instructions.",
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "default": [],
          "description": "Tool names this session may use. Empty means every registered tool.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "StartResponse": {
      "description": "What a caller gets back after starting or resuming.",
      "properties": {
        "next_seq": {
          "description": "The cursor a client resumes from.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "description": "Which session.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SessionState",
          "description": "Where it is."
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "#/$defs/StopReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why it stopped, when it did."
        }
      },
      "required": [
        "session",
        "state",
        "next_seq"
      ],
      "type": "object"
    },
    "StopReason": {
      "description": "Why a session stopped.\n\nFour layers, all present: a provider's `finish_reason`, the step cap, the wall clock,\nand the cost ledger. Each alone can be defeated; together they cannot.",
      "oneOf": [
        {
          "const": "completed",
          "description": "The model said it was finished and no stop condition fired first.",
          "type": "string"
        },
        {
          "const": "steps",
          "description": "The step cap was reached.",
          "type": "string"
        },
        {
          "const": "tokens",
          "description": "The token budget was spent.",
          "type": "string"
        },
        {
          "const": "cost",
          "description": "The cost budget was spent.",
          "type": "string"
        },
        {
          "const": "wall",
          "description": "The wall-clock budget was spent.",
          "type": "string"
        },
        {
          "const": "denied",
          "description": "Policy denied a call.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "A tool or model call failed.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Stopped on request.",
          "type": "string"
        }
      ]
    },
    "TextPart": {
      "description": "Plain text.",
      "properties": {
        "text": {
          "description": "The text.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "ToolCall": {
      "description": "One tool invocation.",
      "properties": {
        "arguments_json": {
          "description": "A JSON object, kept as text so that a replay is byte-faithful.",
          "type": "string"
        },
        "id": {
          "description": "The correlation id.",
          "type": "string"
        },
        "meta": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Opaque extension, same rule as [`Part::meta`].",
          "type": "object"
        },
        "name": {
          "description": "The tool name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "arguments_json"
      ],
      "type": "object"
    },
    "ToolCallPart": {
      "description": "The model asking for a tool.",
      "properties": {
        "call": {
          "$ref": "#/$defs/ToolCall",
          "description": "The call."
        }
      },
      "required": [
        "call"
      ],
      "type": "object"
    },
    "ToolResult": {
      "description": "How a tool call ended.\n\n**Failure is a flag, not a branch.** A failed call still carries content, because the\nerror text is something the model must be able to read and reason about; putting the\nfailure outside the content model would leave the model with a message it cannot see.\nThe cost is honest: `is_error` is a runtime flag a client can forget to check, where a\n`oneof` would have been enforced by the type system.\n\nOne rule constrains the recursion `Content → Part → ToolResult → Content` otherwise\nallows: a tool result's content may contain any kind **except** [`PartKind::ToolCall`] or\n[`PartKind::ToolResult`]. Nesting is one level deep, and a validator enforces it.",
      "properties": {
        "call_id": {
          "description": "The call this answers.",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/Content",
          "description": "What came back — on success and on failure alike."
        },
        "is_error": {
          "description": "Whether the call failed.",
          "type": "boolean"
        }
      },
      "required": [
        "call_id",
        "content",
        "is_error"
      ],
      "type": "object"
    },
    "ToolResultPart": {
      "description": "A tool's answer.",
      "properties": {
        "result": {
          "$ref": "#/$defs/ToolResult",
          "description": "The result."
        }
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    "Usage": {
      "description": "What a model call consumed.\n\nA counter the provider did not report stays `None` rather than becoming zero: a budget\nthat charges for silence is worse than one that knows it does not know.",
      "properties": {
        "input_tokens": {
          "description": "Prompt tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "micros_usd": {
          "description": "Cost in micro-USD, when the provider reported one.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "description": "Completion tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "type": "object"
    },
    "VerdictRequest": {
      "description": "What a caller sends to answer a parked call.",
      "properties": {
        "option_id": {
          "description": "Which offered option was picked.",
          "type": "string"
        },
        "tool_call_id": {
          "description": "Which call was gated.",
          "type": "string"
        }
      },
      "required": [
        "tool_call_id",
        "option_id"
      ],
      "type": "object"
    }
  },
  "$id": "https://nucleos.dev/schema/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The nucleos ABI. Events are server-sent frames whose `event` field is the routable type and whose `id` is the sequence number; every other endpoint is JSON over HTTP.",
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorBody",
      "description": "The body of every failure."
    },
    "event": {
      "$ref": "#/$defs/Event",
      "description": "What one `GET /v1/sessions/{id}/events` frame carries.\n\nThere is no frame *type*: a server-sent event already gives the type (`event:`) and the\ncursor (`id:`), and a second type restating them is a second truth."
    },
    "ledger": {
      "$ref": "#/$defs/Ledger",
      "description": "What a call cost, attempt by attempt."
    },
    "message": {
      "$ref": "#/$defs/Message",
      "description": "The conversation model, for a client that sends `initial` messages."
    },
    "start_request": {
      "$ref": "#/$defs/StartRequest",
      "description": "`POST /v1/sessions`."
    },
    "start_response": {
      "$ref": "#/$defs/StartResponse",
      "description": "What that returns."
    },
    "verdict_request": {
      "$ref": "#/$defs/VerdictRequest",
      "description": "`POST /v1/sessions/{id}/verdict`."
    }
  },
  "required": [
    "event",
    "start_request",
    "start_response",
    "verdict_request",
    "error",
    "message",
    "ledger"
  ],
  "title": "nucleos.v1",
  "type": "object"
}
